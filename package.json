{
  "name": "peligroso",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build:shared",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:shared": "npm run build --workspace=shared",
    "build": "npm run build:shared && npm run build --workspace=client"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
